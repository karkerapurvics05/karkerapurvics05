> expected <- outer(row_totals, col_totals) / grand_total
> # Formula: Sum((O - E)^2 / E)
> chi_sq_stat <- sum((observed - expected)^2 / expected)
> df <- (nrow(observed) - 1) * (ncol(observed) - 1)
